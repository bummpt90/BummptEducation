# ==============================================================================
# BummptEducation — Environment Configuration Template (.env.example)
# ==============================================================================
# SECURITY NOTICE:
# - Never commit real secrets, passwords, or cryptographic keys into version control.
# - All placeholders below must be replaced via secure secret injection in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUCTION-REQUIRED VARIABLES
# ------------------------------------------------------------------------------

# NODE_ENV: Runtime execution environment ('production' | 'development').
# In 'production', fail-closed security guards are enforced and all development/demo
# seeders and preview identity endpoints are strictly disabled.
NODE_ENV="production"

# PORT: TCP port the Node/Express server binds to on host 0.0.0.0 (default: 3000).
# In containerized/cloud deployments, the hosting runtime supplies process.env.PORT.
PORT="3000"

# APP_URL: Canonical public HTTPS origin where BummptEducation is hosted.
# Must use https:// in production. Used for strict CORS origin verification and links.
APP_URL="https://your-school-domain.example.edu.ng"

# DATABASE_URL: Authoritative PostgreSQL 15+ connection string.
# Mandatory in production (server refuses startup if missing).
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require"

# DATABASE_POOL_SIZE: Maximum connections in the PostgreSQL pool (default: 10 in prod, 5 in dev).
DATABASE_POOL_SIZE="10"

# DATABASE_SSL: PostgreSQL TLS/SSL transport mode ('require' | 'true' | 'disable').
# Must be 'require' or 'true' for production PostgreSQL connections.
DATABASE_SSL="require"

# AUTH_SECRET: High-entropy cryptographic secret for signing HS256 JWT session tokens.
# Mandatory in production; must be at least 32 characters long.
# Legacy JWT_SECRET is strictly rejected in production.
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="<replace-with-minimum-32-character-random-auth-secret>"

# ENCRYPTION_SECRET: Dedicated Base64-encoded 32-byte (256-bit) key for AES-256-GCM encryption.
# Mandatory in production; must be strictly independent from AUTH_SECRET.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_SECRET="<replace-with-32-byte-base64-encoded-encryption-secret>"


# ------------------------------------------------------------------------------
# 2. DEVELOPMENT / PREVIEW VARIABLES
# ------------------------------------------------------------------------------

# ALLOWED_ORIGINS: Optional comma-separated list of additional trusted HTTPS origins for CORS.
# Wildcard (*) is strictly prohibited.
ALLOWED_ORIGINS=""

# AUTH_TOKEN_EXPIRES_IN: Session token lifetime duration (default: 8h).
AUTH_TOKEN_EXPIRES_IN="8h"

# DEBUG_SQL: Set to 'true' ONLY in local development to log SQL query execution timing.
# Keep 'false' in production.
DEBUG_SQL="false"

# DISABLE_HMR: Used in preview container environments to disable Vite HMR file watching.
DISABLE_HMR="false"


# ------------------------------------------------------------------------------
# 3. OPTIONAL PLATFORM / AI STUDIO VARIABLES (NOT REQUIRED BY PRODUCTION FEATURES)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY: Optional platform variable injected by AI Studio preview environments.
# BummptEducation core academic, financial, attendance, and Ministry workflows do not
# require GEMINI_API_KEY in production.
GEMINI_API_KEY="<optional-platform-api-key>"
